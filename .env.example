# LLM Diversion Lab: server secrets and settings.
#
# On the lab host this becomes /srv/lab/secrets/lab.env (mode 0600, owner lab).
# Push it with ./deploy/secrets.sh <host>, which prompts for each variable below (or
# reads --from-file), checks it against its type and never prints values. Never put
# real values in this file or anywhere in git.
#
# Each variable's comment ends with [required] or [optional] and one type tag:
#   [secret] key or token   [usd] amount in USD    [int] positive integer
#   [url] https:// URL      [email] e-mail address [host] host name
#   [port] TCP port         [text] free text
# Values are one line without whitespace, quotes, backslashes, '$', '`' or '#'.
#
# Generated on the host, so not listed here: /srv/lab/secrets/hmac.key (callback
# tokens) and /srv/lab/secrets/web-basic-auth (Caddy login), both by bootstrap.sh.

# --- Model providers. M0 calls no provider (stub gateway only), so M0 can use a
# --- placeholder key with ./deploy/secrets.sh <host> --no-test-calls.

# Anthropic API key (sk-ant-...), used by the LLM gateway [required] [secret]
ANTHROPIC_API_KEY=
# OpenAI API key (sk-...), for agents or models served by OpenAI [optional] [secret]
OPENAI_API_KEY=
# Google Gemini API key [optional] [secret]
GEMINI_API_KEY=
# OpenRouter API key [optional] [secret]
OPENROUTER_API_KEY=

# --- Control plane

# Password of the control-plane Postgres role `lab` (deploy/compose/control-plane.yml
# refuses to start without it). Set it once, before the first release: Postgres
# keeps the password it was initialised with, so changing it here later locks the
# Collector out until the role's password is changed to match [optional] [secret]
LAB_DB_PASSWORD=

# --- Budget and concurrency

# Hard spend ceiling for the whole experiment; the pilot pauses before exceeding it [required] [usd]
LAB_BUDGET_USD=
# Cell concurrency limit; at most max_parallel_cells for this host in hosts.yml [optional] [int]
LAB_MAX_PARALLEL=

# --- Notifications (TRACKING.md: alerts are pushed, nobody watches the box)

# Webhook for alerts (Slack, Discord, Mattermost or generic JSON) [optional] [url]
NOTIFY_WEBHOOK_URL=
# ntfy topic for alerts (a hard-to-guess name acts as the password) [optional] [secret]
NOTIFY_NTFY_TOPIC=
# SMTP server for e-mail alerts [optional] [host]
NOTIFY_SMTP_HOST=
# SMTP port (usually 587 with STARTTLS) [optional] [port]
NOTIFY_SMTP_PORT=
# SMTP user name [optional] [text]
NOTIFY_SMTP_USER=
# SMTP password [optional] [secret]
NOTIFY_SMTP_PASSWORD=
# Sender address for e-mail alerts [optional] [email]
NOTIFY_SMTP_FROM=
# Recipient address for e-mail alerts [optional] [email]
NOTIFY_SMTP_TO=
