# {{ ansible_managed }} (role firewall)
[Unit]
Description=Lab host input firewall (nftables table inet lab_host)
Wants=network-pre.target
Before=network-pre.target docker.service shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft --file /etc/lab/host.nft
ExecReload=/usr/sbin/nft --file /etc/lab/host.nft
# Apply a changed ruleset with `systemctl reload lab-firewall` (atomic table
# replace); `restart` also restarts Docker, which Requires= this unit.
# No ExecStop on purpose: with live-restore, cells outlive a stop of this unit (and
# of Docker), so the table stays loaded until reboot or an explicit
# `nft delete table inet lab_host`.

[Install]
WantedBy=multi-user.target
