#!/usr/sbin/nft -f
# {{ ansible_managed }} (role firewall)
# The lab host's own input rules. Loaded by lab-firewall.service. This file only
# ever replaces its own table: Docker keeps its rules in other tables, so a ruleset
# flush must never be used here.

table inet lab_host
delete table inet lab_host

table inet lab_host {
	set cell_nets {
		type ipv4_addr
		flags interval
		elements = { {{ lab_cell_networks | join(', ') }} }
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		# Run cells never reach the LXC itself (a Docker internal network still
		# lets containers reach host services on the bridge address).
		ip saddr @cell_nets counter drop comment "lab: cell to host"
		ct state established,related accept
		ct state invalid drop
		meta l4proto icmp accept
		tcp dport { {{ firewall_ssh_port }}, {{ firewall_https_port }} } accept comment "lab: ssh, caddy"
		counter comment "lab: dropped inbound"
	}
}
