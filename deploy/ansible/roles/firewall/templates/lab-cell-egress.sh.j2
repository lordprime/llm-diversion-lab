#!/usr/bin/env bash
# {{ ansible_managed }} (role firewall)
# Run-cell egress rules in Docker's DOCKER-USER chain (DEPLOYMENT §4.3 firewall).
# This is the SECOND layer: the first is table inet lab_host (forward and input
# chains plus a strict reverse-path check), which is loaded before Docker can start.
#
# Cells are matched by ingress interface (cell bridges are named labc<short-id>) and
# by source address, so a forged source does not escape. From a cell bridge, only
# traffic to another cell bridge inside the cell networks (Docker's per-network
# isolation decides there) and to the LLM gateway, if configured, goes on to
# Docker's own rules; everything else is dropped. Docker preserves DOCKER-USER
# across restarts; lab-cell-egress.service re-applies it whenever Docker starts.
#
#   apply  replace DOCKER-USER atomically (iptables-restore --noflush), then check
#   check  DOCKER-USER equals exactly these rules (as `iptables -S` prints them),
#          FORWARD jumps to it, and table inet lab_host is loaded
#   show   print the rules in iptables-restore format
set -Eeuo pipefail

CELL_NETS=({% for net in lab_cell_networks %}{{ net | quote }}{{ ' ' if not loop.last else '' }}{% endfor %})
GATEWAY_ADDR={{ lab_llm_gateway_address | quote }}
GATEWAY_PORT={{ lab_llm_gateway_port | string | quote }}
TAG={{ firewall_cell_egress_tag | quote }}
BRIDGES=labc+
IPT=(iptables --wait 10)

# The rules, written in the exact form `iptables -S` prints them (option order
# -s -d -i -o -p, then matches), so `check` can compare them line for line.
rule_lines() {
	local src dst cmt="-m comment --comment $TAG"
	for src in "${CELL_NETS[@]}"; do
		for dst in "${CELL_NETS[@]}"; do
			echo "-A DOCKER-USER -s $src -d $dst -i $BRIDGES -o $BRIDGES $cmt -j RETURN"
		done
		if [[ -n $GATEWAY_ADDR ]]; then
			echo "-A DOCKER-USER -s $src -d $GATEWAY_ADDR/32 -i $BRIDGES -p tcp -m tcp --dport $GATEWAY_PORT $cmt -j RETURN"
		fi
	done
	echo "-A DOCKER-USER -i $BRIDGES $cmt -j DROP"
	for src in "${CELL_NETS[@]}"; do
		echo "-A DOCKER-USER -s $src $cmt -j DROP"
	done
	echo '-A DOCKER-USER -j RETURN'
}

rules() {
	echo '*filter'
	echo ':DOCKER-USER - [0:0]'
	rule_lines
	echo 'COMMIT'
}

check() {
	local want have
	want=$(rule_lines)
	have=$("${IPT[@]}" -S DOCKER-USER | grep '^-A' || true)
	if [[ $want != "$have" ]]; then
		echo "DOCKER-USER differs from the lab's rules:" >&2
		diff <(printf '%s\n' "$want") <(printf '%s\n' "$have") >&2 || true
		return 1
	fi
	if ! "${IPT[@]}" -C FORWARD -j DOCKER-USER 2>/dev/null; then
		echo "FORWARD does not jump to DOCKER-USER" >&2
		return 1
	fi
	# Capture first, then grep: under pipefail, `nft list | grep -q` fails whenever
	# grep exits on its match before nft has written everything (SIGPIPE).
	local fwd pre
	fwd=$(nft list chain inet lab_host forward 2>/dev/null || true)
	pre=$(nft list chain inet lab_host prerouting 2>/dev/null || true)
	if ! grep -q '"lab: cell egress"' <<<"$fwd" ||
		! grep -Eq 'fib saddr \. iif (oif|check) missing' <<<"$pre"; then
		echo "nftables table inet lab_host (forward drop, reverse-path check) is not loaded" >&2
		return 1
	fi
	echo "OK: cell egress rules in DOCKER-USER for ${CELL_NETS[*]} and $BRIDGES; host table loaded"
}

case ${1:-apply} in
apply)
	rules | iptables-restore --wait 10 --noflush
	"${IPT[@]}" -C FORWARD -j DOCKER-USER 2>/dev/null || "${IPT[@]}" -I FORWARD 1 -j DOCKER-USER
	check
	;;
check) check ;;
show) rules ;;
*)
	echo "usage: lab-cell-egress apply|check|show" >&2
	exit 2
	;;
esac
