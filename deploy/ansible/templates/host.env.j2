# {{ ansible_managed }} (site.yml)
# Host profile for labctl and the runner. Not secret; secrets are in secrets/lab.env.
LAB_HOST={{ inventory_hostname }}
LAB_ISOLATION={{ isolation }}
LAB_ACCESS={{ access }}
LAB_MAX_PARALLEL_CELLS={{ max_parallel_cells }}
LAB_CELL_NETWORKS={{ lab_cell_networks | join(',') }}
LAB_LLM_GATEWAY={{ (lab_llm_gateway_address ~ ':' ~ lab_llm_gateway_port) if lab_llm_gateway_address else '' }}
LAB_DOCKER_VERSION={{ docker_server_version | default('unknown') }}
# true only with allow_containerd_pin (CVE-2025-52881 stopgap): every run records it.
LAB_CONTAINERD_PINNED={{ 'true' if (docker_containerd_pinned | default(false)) else 'false' }}
