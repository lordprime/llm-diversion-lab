{
  "$defs": {
    "Arm": {
      "description": "The three arms of a block (register items T1 and S1).\n\n* ``control``: the clean site, no tag and nothing planted;\n* ``neutral``: the same surfaces, tag and markup as the instruction, with matched\n  innocuous text that asks for nothing;\n* ``instruction``: the prevention prompt itself.\n\nBefore the three-arm design the treated arm was called ``injected``. That value is\nstill read (as :attr:`INSTRUCTION`) for one release, so manifests and rows written\nby M0 and M1a stay readable; nothing writes it any more.",
      "enum": [
        "control",
        "neutral",
        "instruction"
      ],
      "title": "Arm",
      "type": "string"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "A planned placement: where a prevention prompt *should* be served in a run.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "offset_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Fraction"
        },
        "payload_id": {
          "minLength": 1,
          "title": "Payload Id",
          "type": "string"
        },
        "payload_version": {
          "minLength": 1,
          "title": "Payload Version",
          "type": "string"
        },
        "placement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Placement Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "surface": {
          "$ref": "#/$defs/Surface"
        },
        "tag": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Tag",
          "type": "string"
        },
        "token": {
          "pattern": "^[a-z2-7]{12}$",
          "title": "Token",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "placement_id",
        "run_id",
        "surface",
        "url",
        "locator",
        "payload_id",
        "payload_version",
        "tag",
        "token",
        "content_sha256"
      ],
      "title": "Placement",
      "type": "object"
    },
    "Surface": {
      "description": "Where a placement lives on the target (DEVELOPMENT_PLAN section 4.4).",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7",
        "P8"
      ],
      "title": "Surface",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Everything planned for one run, written before the agent starts.\n\nA control run is tag-free: no ``tag`` and no placements. A neutral or instruction\nrun has a tag and at least one placement, each belonging to this run and carrying\nits tag, so the control run is the only tag-free run of its block.\n\n``block_id`` names the run's block (one control, one neutral and one instruction\nrun of the same cell and repetition). A manifest written before the three-arm design\nnames it ``pair_id``; that key is still read for one release.",
  "properties": {
    "agent": {
      "minLength": 1,
      "title": "Agent",
      "type": "string"
    },
    "arm": {
      "$ref": "#/$defs/Arm"
    },
    "attempt": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "block_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
      "title": "Block Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "experiment_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "placements": {
      "items": {
        "$ref": "#/$defs/Placement"
      },
      "title": "Placements",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schedule_index": {
      "minimum": 0,
      "title": "Schedule Index",
      "type": "integer"
    },
    "tag": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tag"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "experiment_id",
    "block_id",
    "arm",
    "target",
    "agent",
    "model",
    "schedule_index",
    "tag",
    "placements",
    "created_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
