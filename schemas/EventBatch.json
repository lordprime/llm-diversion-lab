{
  "$defs": {
    "AgentEvent": {
      "additionalProperties": false,
      "description": "One normalised step of the agent trajectory (adapter ``collect()``).",
      "properties": {
        "event_type": {
          "$ref": "#/$defs/AgentEventType"
        },
        "kind": {
          "const": "agent_event",
          "default": "agent_event",
          "title": "Kind",
          "type": "string"
        },
        "native_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Ref"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "stream": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Stream",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "tool_args": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Args"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "run_id",
        "stream",
        "seq",
        "ts",
        "event_type"
      ],
      "title": "AgentEvent",
      "type": "object"
    },
    "AgentEventType": {
      "enum": [
        "llm_call",
        "tool_call",
        "http_request",
        "message",
        "final_report"
      ],
      "title": "AgentEventType",
      "type": "string"
    },
    "Callback": {
      "additionalProperties": false,
      "description": "One HTTP/HTTPS or DNS contact recorded by the callback catcher.\n\n``token`` is set only when a well-formed token was extracted; the raw request is\nalways kept in ``url``/``headers``/``body_b64`` or ``qname``.",
      "properties": {
        "body_b64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body B64"
        },
        "channel": {
          "$ref": "#/$defs/CallbackChannel"
        },
        "headers": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Headers",
          "type": "array"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "kind": {
          "const": "callback",
          "default": "callback",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "placement_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placement Id"
        },
        "qname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qname"
        },
        "qtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qtype"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ip"
        },
        "stream": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Stream",
          "type": "string"
        },
        "token": {
          "anyOf": [
            {
              "pattern": "^[a-z2-7]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "run_id",
        "stream",
        "seq",
        "ts",
        "channel"
      ],
      "title": "Callback",
      "type": "object"
    },
    "CallbackChannel": {
      "enum": [
        "http",
        "dns"
      ],
      "title": "CallbackChannel",
      "type": "string"
    },
    "JsonValue": {},
    "LlmCall": {
      "additionalProperties": false,
      "description": "One LLM request/response pair captured by the tap; the basis of *visible*.\n\n``first_tag_seq`` is the ``seq`` of the first call in the run whose request body\ncontained the run's tag (after JSON-unescaping), or ``None`` if none has yet.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "first_tag_seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Tag Seq"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "kind": {
          "const": "llm_call",
          "default": "llm_call",
          "title": "Kind",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "refusal": {
          "default": false,
          "title": "Refusal",
          "type": "boolean"
        },
        "refusal_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refusal Category"
        },
        "request_artifact": {
          "minLength": 1,
          "title": "Request Artifact",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Model"
        },
        "response_artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Artifact"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "returned_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model"
        },
        "role": {
          "$ref": "#/$defs/LlmRole",
          "default": "main"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "stream": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Stream",
          "type": "string"
        },
        "tag_present": {
          "title": "Tag Present",
          "type": "boolean"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "stream",
        "seq",
        "ts",
        "tag_present",
        "request_sha256",
        "request_artifact"
      ],
      "title": "LlmCall",
      "type": "object"
    },
    "LlmRole": {
      "description": "Whether an LLM call was the agent's main call or a secondary (summariser) call.",
      "enum": [
        "main",
        "secondary"
      ],
      "title": "LlmRole",
      "type": "string"
    },
    "OraclePoll": {
      "additionalProperties": false,
      "description": "One poll of the oracle's ``GET /done`` (``{\"status\": bool, \"message\": str}``).",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "kind": {
          "const": "oracle_poll",
          "default": "oracle_poll",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "boolean"
        },
        "stream": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Stream",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "stream",
        "seq",
        "ts",
        "status"
      ],
      "title": "OraclePoll",
      "type": "object"
    },
    "PlacementServe": {
      "additionalProperties": false,
      "description": "A realised placement: one delivery of planted bytes by the surface injector.",
      "properties": {
        "byte_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Offset"
        },
        "decoded_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decoded Sha256",
          "type": "string"
        },
        "flow_id": {
          "minLength": 1,
          "title": "Flow Id",
          "type": "string"
        },
        "insert_ok": {
          "title": "Insert Ok",
          "type": "boolean"
        },
        "kind": {
          "const": "placement_serve",
          "default": "placement_serve",
          "title": "Kind",
          "type": "string"
        },
        "placement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Placement Id",
          "type": "string"
        },
        "probe": {
          "default": false,
          "title": "Probe",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status",
          "type": "integer"
        },
        "stream": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Stream",
          "type": "string"
        },
        "surface": {
          "$ref": "#/$defs/Surface"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "wire_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Wire Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "stream",
        "seq",
        "ts",
        "placement_id",
        "surface",
        "flow_id",
        "url",
        "status",
        "decoded_sha256",
        "wire_sha256",
        "insert_ok"
      ],
      "title": "PlacementServe",
      "type": "object"
    },
    "Surface": {
      "description": "Where a placement lives on the target (DEVELOPMENT_PLAN section 4.4).",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7"
      ],
      "title": "Surface",
      "type": "string"
    },
    "TargetAccessEvent": {
      "additionalProperties": false,
      "description": "One agent (or pre-flight probe) request to the target, seen by the injector.",
      "properties": {
        "flow_id": {
          "minLength": 1,
          "title": "Flow Id",
          "type": "string"
        },
        "kind": {
          "const": "target_access",
          "default": "target_access",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "probe": {
          "default": false,
          "title": "Probe",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ip"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "stream": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "title": "Stream",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "stream",
        "seq",
        "ts",
        "flow_id",
        "method",
        "url"
      ],
      "title": "TargetAccessEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``POST /v1/runs/{run_id}/events:batch`` body.",
  "properties": {
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "agent_event": "#/$defs/AgentEvent",
            "callback": "#/$defs/Callback",
            "llm_call": "#/$defs/LlmCall",
            "oracle_poll": "#/$defs/OraclePoll",
            "placement_serve": "#/$defs/PlacementServe",
            "target_access": "#/$defs/TargetAccessEvent"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TargetAccessEvent"
          },
          {
            "$ref": "#/$defs/PlacementServe"
          },
          {
            "$ref": "#/$defs/LlmCall"
          },
          {
            "$ref": "#/$defs/AgentEvent"
          },
          {
            "$ref": "#/$defs/Callback"
          },
          {
            "$ref": "#/$defs/OraclePoll"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "events"
  ],
  "title": "EventBatch",
  "type": "object"
}
