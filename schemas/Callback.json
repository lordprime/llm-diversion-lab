{
  "$defs": {
    "CallbackChannel": {
      "enum": [
        "http",
        "dns"
      ],
      "title": "CallbackChannel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One HTTP/HTTPS or DNS contact recorded by the callback catcher.\n\n``token`` is set only when a well-formed token was extracted; the raw request is\nalways kept in ``url``/``headers``/``body_b64`` or ``qname``.\n\nAn HTTP body is kept inline (``body_b64``) only up to the catcher's cap; the rest\nis read and discarded. ``body_size`` and ``body_sha256`` always describe the\n*whole* body as received, and ``body_truncated`` says whether ``body_b64`` holds\nonly its first bytes. DNS callbacks leave all body fields unset.",
  "properties": {
    "body_b64": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body B64"
    },
    "body_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Sha256"
    },
    "body_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Size"
    },
    "body_truncated": {
      "default": false,
      "title": "Body Truncated",
      "type": "boolean"
    },
    "channel": {
      "$ref": "#/$defs/CallbackChannel"
    },
    "headers": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Headers",
      "type": "array"
    },
    "host": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host"
    },
    "kind": {
      "const": "callback",
      "default": "callback",
      "title": "Kind",
      "type": "string"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "placement_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Placement Id"
    },
    "qname": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qname"
    },
    "qtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qtype"
    },
    "query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ip"
    },
    "stream": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "title": "Stream",
      "type": "string"
    },
    "token": {
      "anyOf": [
        {
          "pattern": "^[a-z2-7]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "run_id",
    "stream",
    "seq",
    "ts",
    "channel"
  ],
  "title": "Callback",
  "type": "object"
}
