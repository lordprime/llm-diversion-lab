+class LabTaggedChatOpenAI(ChatOpenAI):
+    """ChatOpenAI that names the calling agent in each request's ``user`` field.
+
+    Lab patch: the LLM tap records request bodies only, so the agent behind each
+    call is written into the standard OpenAI ``user`` field as
+    ``redamon:<purpose>:<agent>``. The purpose comes from the ``current_llm_purpose``
+    ContextVar every call site already sets. The agent is the member that label
+    names, else the member whose task is running (a tool such as query_graph run
+    by a member), else ``root``. The model never sees the field.
+    """
+
+    def _get_request_payload(self, input_, *, stop=None, **kwargs):
+        from agent_context import current_llm_purpose
+        from orchestrator_helpers.member_streaming import _member_streaming_ctx
+
+        payload = super()._get_request_payload(input_, stop=stop, **kwargs)
+        label = current_llm_purpose.get() or {}
+        purpose = str(label.get("purpose") or "other")
+        member = _member_streaming_ctx.get()
+        agent = str(label.get("member_id") or getattr(member, "_member_id", "") or "root")
+        payload["user"] = f"redamon:{purpose}:{agent}"
+        return payload
+
