--- a/backend/pkg/providers/ollama/ollama.go
+++ b/backend/pkg/providers/ollama/ollama.go
@@ -229,6 +229,11 @@ func New(
 		ollama.WithModel(baseModel),
 	}
 
+	// A pinned context window travels with every request (options.num_ctx).
+	if cfg.OllamaServerNumCtx > 0 {
+		options = append(options, ollama.WithRunnerNumCtx(cfg.OllamaServerNumCtx))
+	}
+
 	// Add API key for Ollama Cloud support
 	if cfg.OllamaServerAPIKey != "" {
 		options = append(options, ollama.WithAPIKey(cfg.OllamaServerAPIKey))
